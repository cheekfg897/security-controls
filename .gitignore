# Per-control test workspaces (may contain sensitive data)
framework/results/*
!framework/results/README.md
framework/submissions/*.zip
*.log
*.evtx

# Credential or dump files (never commit these)
*.dmp
*.lsass
*.kirbi
*.ccache
lsass*
mimikatz*

# Python
__pycache__/
*.pyc
*.pyo
.env
ai-system/.venv/
ai-system/.tools/
.pytest_cache/
*.egg-info/

# Generated comparison runs and local AI-system configuration
ai-system/comparisons/*
!ai-system/comparisons/README.md
ai-system/config/config.local.comparison.json
ai-system/config/config.local.ai.json
ai-system/offline-bundles/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Malware sample archives (never commit real malware)
framework/samples/*.zip
framework/samples/*.7z
framework/samples/*.tar.gz

# Locally built Office macro test documents
framework/scenarios/02-exploitation/v2.1-malicious-macro/*.docm

# VM / lab artifacts
*.vmdk
*.vmx
*.ovf
*.ova
*.snapshot

# Editor folders
.vscode/
.idea/

# Sensitive config (API keys, credentials, IPs)
config.local.*
secrets.*
*.env
