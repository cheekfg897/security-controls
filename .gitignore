# Raw test results & logs (may contain sensitive data)
results/raw/
*.log
*.evtx

# Credential or dump files (never commit these)
*.dmp
*.lsass
*.kirbi
*.ccache
lsass*
mimikatz*

# Python
__pycache__/
*.pyc
*.pyo
.env

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Malware sample archives (never commit real malware)
samples/*.zip
samples/*.7z
samples/*.tar.gz

# VM / lab artifacts
*.vmdk
*.vmx
*.ovf
*.ova
*.snapshot

# Editor folders
.vscode/
.idea/

# Sensitive config (API keys, credentials, IPs)
config.local.*
config/control-profile.local.json
secrets.*
*.env

# Generated human-review files
results/analysis/*
!results/analysis/.gitkeep
