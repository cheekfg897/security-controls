# Raw test results & logs (may contain sensitive data)
results/raw/
*.log
*.evtx

# Credential or dump files (never commit these)
*.dmp
*.lsass
*.kirbi
*.ccache
lsass*
mimikatz*

# Python
__pycache__/
*.pyc
*.pyo
.env

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# VM / lab artifacts
*.vmdk
*.vmx
*.ovf
*.ova
*.snapshot

# Editor folders
.vscode/
.idea/

# Sensitive config (API keys, credentials, IPs)
config.local.*
secrets.*
*.env
